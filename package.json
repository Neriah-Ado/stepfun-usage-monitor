{
  "name": "stepfun-usage-monitor",
  "version": "1.5.0",
  "description": "StepFun API Token 用量本地监控代理：零依赖、低开销、数据全本地，内置轻量/进阶/极致 3 档性能模式，支持 npx 从 GitHub URL 直载，兼容任意 OpenAI 兼容 Agent（ZCode/Cline/Continue/Cherry Studio 等）",
  "type": "module",
  "main": "proxy.mjs",
  "bin": {
    "stepfun-usage-monitor": "bin/cli.mjs"
  },
  "files": [
    "proxy.mjs",
    "mcp-server.mjs",
    "stats.mjs",
    "dashboard.html",
    "bin/",
    "lib/",
    "start.cmd",
    "open-window.cmd",
    "open-panel.cmd",
    "zcode/",
    "ide-extension/README.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neriah-Ado/stepfun-usage-monitor.git"
  },
  "homepage": "https://github.com/Neriah-Ado/stepfun-usage-monitor#readme",
  "bugs": {
    "url": "https://github.com/Neriah-Ado/stepfun-usage-monitor/issues"
  },
  "scripts": {
    "start": "node proxy.mjs",
    "stats": "node stats.mjs",
    "mcp": "node mcp-server.mjs",
    "test:e2e": "node test/run-e2e.mjs",
    "test:mcp": "node test/mcp-test.mjs",
    "test:ui": "node test/verify-ui.mjs",
    "test:ui-perf": "node test/ui-perf-check.mjs",
    "test:v15": "node test/v15-check.mjs",
    "test:browser": "node test/browser-smoke.mjs",
    "test:pack": "node test/npm-pack-check.mjs",
    "test:parity": "node test/replay-parity.mjs",
    "bench": "node test/bench.mjs",
    "seed": "node test/seed-demo.mjs demo-data"
  },
  "keywords": [
    "stepfun",
    "token-usage",
    "usage-monitor",
    "openai-compatible",
    "proxy",
    "llm",
    "mcp",
    "zcode",
    "cline",
    "local-first"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Neriah-Ado"
}
